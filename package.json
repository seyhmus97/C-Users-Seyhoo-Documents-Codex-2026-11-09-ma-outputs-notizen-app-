{
  "name": "notizen-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native && node scripts/prepare-native.mjs",
    "preview": "vite preview",
    "generate-pwa-assets": "pwa-assets-generator",
    "icons:generate": "pnpm tauri icon public/pwa-512x512.png --output src-tauri/icons",
    "native:sync": "pnpm run icons:generate && pnpm run build:native && pnpm cap sync",
    "native:sync:android": "pnpm run icons:generate && pnpm run build:native && pnpm cap sync android",
    "native:sync:ios": "pnpm run icons:generate && pnpm run build:native && pnpm cap sync ios",
    "desktop:dev": "pnpm tauri dev",
    "desktop:build": "pnpm run icons:generate && pnpm tauri build"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "2.0.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "^8.0.3",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
